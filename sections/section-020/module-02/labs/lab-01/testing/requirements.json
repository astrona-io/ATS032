{
  "context": "kind-astro-ats-032-lab-020-02-01",
  "cluster": "astro-ats-032-lab-020-02-01",
  "namespace": "starfleet-032-020-02-01",
  "resources": [
    {
      "kind": "serviceaccount",
      "name": "probe",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "apiVersion": "v1",
        "kind": "ServiceAccount",
        "metadata": {
          "name": "probe",
          "namespace": "starfleet-032-020-02-01"
        },
        "automountServiceAccountToken": false
      },
      "outcome": "probe-serviceaccount"
    },
    {
      "kind": "serviceaccount",
      "name": "default",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "apiVersion": "v1",
        "kind": "ServiceAccount",
        "metadata": {
          "name": "default",
          "namespace": "starfleet-032-020-02-01"
        },
        "automountServiceAccountToken": false
      },
      "outcome": "default-account-locked"
    },
    {
      "kind": "deployment",
      "name": "probe",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "spec": {
          "replicas": 2,
          "template": {
            "spec": {
              "serviceAccountName": "probe"
            }
          }
        }
      },
      "state": "deployment",
      "outcome": "probe-serviceaccount"
    },
    {
      "kind": "serviceaccount",
      "name": "pod-lister",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "apiVersion": "v1",
        "kind": "ServiceAccount",
        "metadata": {
          "name": "pod-lister",
          "namespace": "starfleet-032-020-02-01"
        }
      },
      "outcome": "pod-lister-rbac"
    },
    {
      "kind": "role",
      "name": "pod-lister",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "Role",
        "metadata": {
          "name": "pod-lister",
          "namespace": "starfleet-032-020-02-01"
        },
        "rules": [
          {
            "apiGroups": [
              ""
            ],
            "resources": [
              "pods"
            ],
            "verbs": [
              "get",
              "list"
            ]
          }
        ]
      },
      "outcome": "pod-lister-rbac"
    },
    {
      "kind": "rolebinding",
      "name": "pod-lister",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "RoleBinding",
        "metadata": {
          "name": "pod-lister",
          "namespace": "starfleet-032-020-02-01"
        },
        "roleRef": {
          "apiGroup": "rbac.authorization.k8s.io",
          "kind": "Role",
          "name": "pod-lister"
        },
        "subjects": [
          {
            "kind": "ServiceAccount",
            "name": "pod-lister",
            "namespace": "starfleet-032-020-02-01"
          }
        ]
      },
      "outcome": "pod-lister-rbac"
    },
    {
      "kind": "pod",
      "name": "pod-lister",
      "namespace": "starfleet-032-020-02-01",
      "expected": {
        "spec": {
          "serviceAccountName": "pod-lister"
        }
      },
      "state": "pod",
      "outcome": "pod-lister-pod"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-032-020-02-01",
        "exec",
        "deploy/probe",
        "--",
        "sh",
        "-c",
        "test ! -e /var/run/secrets/kubernetes.io/serviceaccount/token && printf absent"
      ],
      "equals": "absent",
      "outcome": "probe-serviceaccount"
    },
    {
      "args": [
        "kubectl",
        "auth",
        "can-i",
        "get",
        "pods",
        "-n",
        "starfleet-032-020-02-01",
        "--as=system:serviceaccount:starfleet-032-020-02-01:pod-lister"
      ],
      "equals": "yes",
      "outcome": "pod-lister-rbac"
    },
    {
      "args": [
        "kubectl",
        "auth",
        "can-i",
        "delete",
        "pods",
        "-n",
        "starfleet-032-020-02-01",
        "--as=system:serviceaccount:starfleet-032-020-02-01:pod-lister"
      ],
      "denied": true,
      "failure_markers": [
        "no"
      ],
      "equals": "no",
      "outcome": "pod-lister-rbac"
    },
    {
      "args": [
        "kubectl",
        "auth",
        "can-i",
        "get",
        "pods",
        "-n",
        "outpost-032-020-02-01",
        "--as=system:serviceaccount:starfleet-032-020-02-01:pod-lister"
      ],
      "denied": true,
      "failure_markers": [
        "no"
      ],
      "equals": "no",
      "outcome": "pod-lister-rbac"
    },
    {
      "args": [
        "kubectl",
        "auth",
        "can-i",
        "get",
        "pods",
        "-n",
        "starfleet-032-020-02-01",
        "--as=system:serviceaccount:starfleet-032-020-02-01:default"
      ],
      "denied": true,
      "failure_markers": [
        "no"
      ],
      "equals": "no",
      "outcome": "default-account-locked"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-032-020-02-01",
        "get",
        "rolebinding",
        "default-pod-access"
      ],
      "denied": true,
      "failure_markers": [
        "not found"
      ],
      "outcome": "default-account-locked"
    }
  ]
}
